      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "dpvStatement__predicate",
      "description": "The predicate, as a CURIE or an IRI.",
      "title": "Predicate",
      "from_schema": "https://w3id.org/lmodel/dpv/dpv_terms",
      "mappings": [
        "http://www.w3.org/1999/02/22-rdf-syntax-ns#predicate"
      ],
      "slot_uri": "http://www.w3.org/1999/02/22-rdf-syntax-ns#predicate",
      "alias": "predicate",
      "owner": "DpvStatement",
      "domain_of": [
        "DpvStatement"
      ],
      "range": "uriorcurie",
      "required": true,
      "pattern": "^[A-Za-z_][A-Za-z0-9_+.-]*:\\S*$",
      "@type": "SlotDefinition"
    },
    {
      "name": "dpvStatement__reference",
      "description": "The object, when it names a resource.",
      "title": "Reference",
      "from_schema": "https://w3id.org/lmodel/dpv/dpv_terms",
      "mappings": [
        "http://www.w3.org/1999/02/22-rdf-syntax-ns#object"
      ],
      "slot_uri": "http://www.w3.org/1999/02/22-rdf-syntax-ns#object",
      "alias": "reference",
      "owner": "DpvStatement",
      "domain_of": [
        "DpvStatement"
      ],
      "range": "uriorcurie",
      "pattern": "^[A-Za-z_][A-Za-z0-9_+.-]*:\\S*$",
      "@type": "SlotDefinition"
    },
    {
      "name": "dpvStatement__literal",
      "description": "The object, when it is a literal, in its lexical form.",
      "title": "Literal",
      "from_schema": "https://w3id.org/lmodel/dpv/dpv_terms",
      "mappings": [
        "http://www.w3.org/1999/02/22-rdf-syntax-ns#value"
      ],
      "slot_uri": "http://www.w3.org/1999/02/22-rdf-syntax-ns#value",
      "alias": "literal",
      "owner": "DpvStatement",
      "domain_of": [
        "DpvStatement"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "dpvStatement__language",
      "description": "The literal's language tag.",
      "title": "Language",
      "from_schema": "https://w3id.org/lmodel/dpv/dpv_terms",
      "slot_uri": "https://w3id.org/lmodel/dpv/language",
      "alias": "language",
      "owner": "DpvStatement",
      "domain_of": [
        "DpvStatement"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "DpvAgent_id",
      "definition_uri": "https://w3id.org/lmodel/dpv/id",
      "description": "The element's IRI as a CURIE or whole, or a blank node's label in an example.",
      "title": "ID",
      "from_schema": "https://w3id.org/lmodel/dpv/dpv_core",
      "is_a": "id",
      "domain": "DpvAgent",
      "slot_uri": "https://w3id.org/lmodel/dpv/id",
      "identifier": true,
      "alias": "id",
      "owner": "DpvAgent",
      "domain_of": [
        "DpvAgent"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "id",
      "range": "uriorcurie",
      "required": true,
      "pattern": "^dpv_agent:(person|org)-[a-z0-9-]+$",
      "@type": "SlotDefinition"
    },
    {
      "name": "DpvExample_title",
      "definition_uri": "https://w3id.org/lmodel/dpv/title",
      "description": "The element's name.",
      "title": "Title",
      "from_schema": "https://w3id.org/lmodel/dpv/dpv_core",
      "mappings": [
        "http://purl.org/dc/terms/title"
      ],
      "is_a": "title",
      "domain": "DpvExample",
      "slot_uri": "http://purl.org/dc/terms/title",
      "alias": "title",
      "owner": "DpvExample",
      "domain_of": [
        "DpvExample"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "title",
      "range": "string",
      "required": true,
      "@type": "SlotDefinition"
    }
  ],
  "classes": [
    {
      "name": "DpvCatalogue",
      "definition_uri": "https://w3id.org/lmodel/dpv/DpvCatalogue",
      "description": "One part of a DPV release: one namespace family's vocabularies and terms, its contributors or its examples.",
      "title": "Catalogue",
      "from_schema": "https://w3id.org/lmodel/dpv",
      "slots": [
        "concepts",
        "dpvCatalogue__edition",
        "dpvCatalogue__family",
        "dpvCatalogue__vocabularies",
        "dpvCatalogue__concept_schemes",
        "dpvCatalogue__properties",
        "dpvCatalogue__agents",
        "dpvCatalogue__examples"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "edition",
          "description": "The DPV release the part belongs to.",
          "title": "Edition",
          "slot_uri": "dcterms:isVersionOf",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "family",
          "description": "Which part of the release this is.",
          "title": "Family",
          "range": "DpvFamily",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "vocabularies",
          "description": "The family's vocabularies, as each one's Turtle file describes it.",
          "title": "Vocabularies",
          "range": "DpvVocabulary",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "concept_schemes",
          "description": "The lists of terms the family's vocabularies keep.",
          "title": "Concept Schemes",
          "range": "DpvConceptScheme",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "properties",
          "description": "The family's properties.",
          "title": "Properties",
          "range": "DpvProperty",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "agents",
          "description": "The people and organizations DPV names as contributors.",
          "title": "Agents",
          "range": "DpvAgent",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "examples",
          "description": "DPV's examples.",
          "title": "Examples",
          "range": "DpvExample",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/dpv/DpvCatalogue",
      "tree_root": true,
      "@type": "ClassDefinition"
    },
    {
      "name": "DpvVocabulary",
      "definition_uri": "https://w3id.org/lmodel/dpv/DpvVocabulary",
      "description": "One of DPV's vocabularies, as its own Turtle file's header describes it.",
      "title": "Vocabulary",
      "from_schema": "https://w3id.org/lmodel/dpv/dpv_core",
      "exact_mappings": [
        "owl:Ontology"
      ],
      "slots": [
        "id",
        "title",
        "description",
        "identifier",
        "bibliographicCitation",
        "conformsTo",
        "created",
        "issued",
        "modified",
        "creator",
        "contributor",
        "publisher",
        "license",
        "source",
        "doi",
        "bibo_status",
        "preferredNamespacePrefix",
        "preferredNamespaceUri",
        "rdfs_Label",
        "versionIRI",
        "versionInfo",
        "schema_version",
        "isProfileOf",
        "logo"
      ],
      "slot_usage": {},
      "class_uri": "http://www.w3.org/2002/07/owl#Ontology",
      "@type": "ClassDefinition"
    },
    {
      "name": "DpvConceptScheme",
      "definition_uri": "https://w3id.org/lmodel/dpv/DpvConceptScheme",
      "description": "A list of terms DPV keeps within a vocabulary. DPV states nothing else about one.",
      "title": "Concept Scheme",
      "from_schema": "https://w3id.org/lmodel/dpv/dpv_core",
      "exact_mappings": [
        "skos:ConceptScheme"
      ],
      "slots": [
        "id"
      ],
      "slot_usage": {},
      "class_uri": "http://www.w3.org/2004/02/skos/core#ConceptScheme",
      "@type": "ClassDefinition"
    },
    {
      "name": "DpvAgent",
      "definition_uri": "https://w3id.org/lmodel/dpv/DpvAgent",
      "description": "A person or an organization DPV names as a contributor, as DPV's files describe them.",
      "title": "Agent",
      "from_schema": "https://w3id.org/lmodel/dpv/dpv_core",
      "exact_mappings": [
        "dcterms:Agent"
      ],
      "slots": [
        "DpvAgent_id",
        "name",
        "homepage",
        "memberOf",
        "dpvAgent__hasORCID"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "hasORCID",
          "description": "The person's ORCID identifier.",
          "title": "ORCID",
          "slot_uri": "scoro:hasORCID",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "http://purl.org/dc/terms/Agent",
      "@type": "ClassDefinition"
    },
    {
      "name": "DpvWebPage",
      "definition_uri": "https://w3id.org/lmodel/dpv/DpvWebPage",
      "description": "A web page DPV names as a term's source.",
      "title": "Web Page",
      "from_schema": "https://w3id.org/lmodel/dpv/dpv_core",
      "exact_mappings": [
        "sdo:WebPage"
      ],
      "slots": [
        "url",
        "dpvWebPage__page_name"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "page_name",
          "description": "The page's title.",
          "title": "Page Name",
          "slot_uri": "sdo:name",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://schema.org/WebPage",
      "@type": "ClassDefinition"
    },
    {
      "name": "DpvInterval",
      "definition_uri": "https://w3id.org/lmodel/dpv/DpvInterval",
      "description": "A period of time, with the dates that start and end it.",
      "title": "Interval",
      "from_schema": "https://w3id.org/lmodel/dpv/dpv_core",
      "exact_mappings": [
        "time:ProperInterval"
      ],
      "slots": [
        "dpvInterval__hasBeginning",
        "dpvInterval__hasEnd"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "hasBeginning",
          "description": "The date the period starts.",
          "title": "Has Beginning",
          "slot_uri": "time:hasBeginning",
          "range": "dpv_date",
          "@type": "SlotDefinition"
        },
        {
          "name": "hasEnd",
          "description": "The date the period ends.",
          "title": "Has End",
          "slot_uri": "time:hasEnd",
          "range": "dpv_date",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "http://www.w3.org/2006/time#ProperInterval",
      "@type": "ClassDefinition"
    },
    {
      "name": "DpvTerm",
      "definition_uri": "https://w3id.org/lmodel/dpv/DpvTerm",
      "description": "One thing DPV's vocabularies state, or a thing a use case describes with them, as a record under its own IRI.",
      "title": "Term",
      "from_schema": "https://w3id.org/lmodel/dpv/dpv_terms",
      "abstract": true,
      "slots": [
