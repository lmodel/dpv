	skos:exactMatch eu-aiact:ServiceSupplyStatus ;
	skos:inScheme dpv_linkml:dpv_legal .
dpv_linkml:DpvSeverity dcterms:title "Severity" ;
	a owl:Class ;
	rdfs:label "DpvSeverity" ;
