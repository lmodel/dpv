dpv_linkml:DpvReuseCompatibility dcterms:title "ReuseCompatibility" ;
	a owl:Class ;
	rdfs:label "DpvReuseCompatibility" ;
	rdfs:subClassOf dpv_linkml:DpvStatus ;
	skos:definition "Status indicating whether the specified context is compatible with another earlier context" ;
	skos:exactMatch dpv:ReuseCompatibility ;
	skos:inScheme dpv_linkml:dpv_kinds .
dpv_linkml:DpvRight dcterms:title "Right" ;
	a owl:Class ;
	rdfs:label "DpvRight" ;
	rdfs:subClassOf dpv_linkml:DpvConcept ;
	skos:definition "The right(s) applicable, provided, or expected" ;
	skos:exactMatch dpv:Right ;
	skos:inScheme dpv_linkml:dpv_kinds .
dpv_linkml:DpvRiskAnalysis dcterms:title "Risk Analysis" ;
	a owl:Class ;
	rdfs:label "DpvRiskAnalysis" ;
	rdfs:subClassOf dpv_linkml:DpvConcept ;
	skos:definition "A technique or method used to analyse and identify risk levels, sources, likelihoods, severities, and other necessary information required to conduct risk management procedures" ;
	skos:exactMatch risk:RiskAnalysis ;
	skos:inScheme dpv_linkml:dpv_risk .
dpv_linkml:DpvRiskConcept dcterms:title "Risk Concept" ;
	a owl:Class ;
	rdfs:label "DpvRiskConcept" ;
	rdfs:subClassOf dpv_linkml:DpvConcept ;
	skos:definition "Parent concept for combining concepts associated with risk assessment such as actual and potential Risk, Risk Source, Consequences, and Impacts" ;
	skos:exactMatch dpv:RiskConcept ;
	skos:inScheme dpv_linkml:dpv_kinds .
dpv_linkml:DpvRiskControl dcterms:title "Risk Control" ;
	a owl:Class ;
	rdfs:label "DpvRiskControl" ;
	rdfs:subClassOf dpv_linkml:DpvConcept ;
	skos:definition "Control that modifies risk" ;
	skos:exactMatch risk:RiskControl ;
	skos:inScheme dpv_linkml:dpv_risk .
dpv_linkml:DpvRiskLevel dcterms:title "Risk Level" ;
	a owl:Class ;
	rdfs:label "DpvRiskLevel" ;
	rdfs:subClassOf dpv_linkml:DpvConcept ;
	skos:definition "The magnitude of a risk expressed as an indication to aid in its management" ;
	skos:exactMatch dpv:RiskLevel ;
	skos:inScheme dpv_linkml:dpv_kinds .
dpv_linkml:DpvRule dcterms:title "Rule" ;
	a owl:Class ;
	rdfs:label "DpvRule" ;
	rdfs:subClassOf dpv_linkml:DpvConcept ;
	skos:definition "A rule describing a process or control that directs or determines if and how an activity should be conducted" ;
	skos:exactMatch dpv:Rule ;
	skos:inScheme dpv_linkml:dpv_kinds .
dpv_linkml:DpvRuleFulfilmentStatus dcterms:title "Rule Fulfilment Status" ;
	a owl:Class ;
	rdfs:label "DpvRuleFulfilmentStatus" ;
	rdfs:subClassOf dpv_linkml:DpvStatus ;
	skos:definition "Status associated with a rule for indicating whether it is applicable, or has been utilised, and whether the requirements of the rule have been fulfilled or violated" ;
	skos:exactMatch dpv:RuleFulfilmentStatus ;
	skos:inScheme dpv_linkml:dpv_kinds .
dpv_linkml:DpvScoringOfIndividuals dcterms:title "Scoring of Individuals" ;
	a owl:Class ;
	rdfs:label "DpvScoringOfIndividuals" ;
	rdfs:subClassOf dpv_linkml:DpvEvaluationScoring ;
	skos:definition "Processing that involves scoring of individuals" ;
	skos:exactMatch dpv:ScoringOfIndividuals ;
	skos:inScheme dpv_linkml:dpv_kinds .
dpv_linkml:DpvSector dcterms:title "Sector" ;
	a owl:Class ;
	rdfs:label "DpvSector" ;
	rdfs:subClassOf dpv_linkml:DpvConcept ;
	skos:definition "Sector describes the area of application or domain that indicates or restricts scope for interpretation and application of purpose e.g. Agriculture, Banking" ;
	skos:exactMatch dpv:Sector ;
	skos:inScheme dpv_linkml:dpv_kinds .
dpv_linkml:DpvSectorHealthReuseCompatibility dcterms:title "ReuseCompatibility" ;
