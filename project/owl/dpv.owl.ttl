	rdfs:label "DpvSpecialCategoryPersonalData" ;
	rdfs:subClassOf dpv_linkml:DpvSensitivePersonalData ;
	skos:definition "Sensitive Personal Data whose use requires specific additional legal permission or justification" ;
	skos:exactMatch dpv:SpecialCategoryPersonalData ;
	skos:inScheme dpv_linkml:dpv_kinds .
