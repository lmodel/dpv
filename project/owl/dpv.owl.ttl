xsd:anyURI a rdfs:Datatype ;
	owl:equivalentClass _:c14n788 .
xsd:date a rdfs:Datatype ;
	owl:equivalentClass _:c14n859 .
<https://w3id.org/lmodel/dpv.owl.ttl> dcterms:license "Apache-2.0" ;
	dcterms:source <https://w3id.org/dpv/2.3> ;
	dcterms:title "Data Privacy Vocabulary (DPV)" ;
	pav:version "2.3" ;
	<http://schema.org/keywords> "DPV" , "GDPR" , "data protection" , "personal data" , "privacy" , "vocabulary" ;
	a owl:Ontology ;
	rdfs:label "dpv" ;
	rdfs:seeAlso <https://lmodel.github.io/dpv> , <https://w3id.org/dpv> ;
	skos:definition "A LinkML model of the Data Privacy Vocabulary (DPV) 2.3 of the W3C Data Privacy Vocabularies and Controls Community Group. DPV states each concept as a class and as an instance of a broader concept, so the model holds its terms as records: each concept that terms are instances of is a class, each property is a slot under its own IRI, and every term of DPV's vocabularies is a record that validates against them." ;
	skos:note "The version is the DPV release the schema renders. upstream/ holds its Turtle files unchanged, scripts/dpv_to_linkml.py writes the terms, the kinds and the catalogue from them, and scripts/check_upstream_release.py reports when they move." ;
	dpv_linkml:upstream_commit "cbcd21567808812677eeb3bb0f05b2ff2c2211a5" ;
	dpv_linkml:upstream_copyright "Copyright the Contributors to the Data Privacy Vocabulary (DPV)" ;
	dpv_linkml:upstream_license "https://www.w3.org/copyright/software-license-2023/" ;
	dpv_linkml:upstream_release_date "2026-02-28" ;
	dpv_linkml:upstream_tag "dpv-2.3" .
dpv_linkml:DpvAISystem dcterms:title "AI System" ;
	a owl:Class ;
	rdfs:label "DpvAISystem" ;
	rdfs:subClassOf dpv_linkml:DpvTechnology ;
	skos:definition "A machine-based system designed to operate with varying levels of autonomy and that may exhibit adaptiveness after deployment and that, for explicit or implicit objectives, infers, from the input it receives, how to generate outputs such as predictions, content, recommendations, or decisions that can influence physical or virtual environments." ;
	skos:exactMatch eu-aiact:AISystem ;
	skos:inScheme dpv_linkml:dpv_legal .
dpv_linkml:DpvActivityStatus dcterms:title "Activity Status" ;
	a owl:Class ;
	rdfs:label "DpvActivityStatus" ;
	rdfs:subClassOf dpv_linkml:DpvStatus ;
	skos:definition "Status associated with activity operations and lifecycles" ;
	skos:exactMatch dpv:ActivityStatus ;
	skos:inScheme dpv_linkml:dpv_kinds .
dpv_linkml:DpvActor dcterms:title "Actor" ;
	a owl:Class ;
	rdfs:label "DpvActor" ;
	rdfs:subClassOf dpv_linkml:DpvConcept ;
	skos:definition "Actors and Entities involved in provision, use, and management of Technology" ;
	skos:exactMatch tech:Actor ;
	skos:inScheme dpv_linkml:dpv_tech .
dpv_linkml:DpvAdequacyDecision dcterms:title "Adequacy Decision" ;
	a owl:Class ;
	rdfs:label "DpvAdequacyDecision" ;
	rdfs:subClassOf dpv_linkml:DpvLegalBasis ;
	skos:definition "An adequacy decision as per GDPR Art.45(3) for the transfer of data to a third country or an international organisation" ;
	skos:exactMatch eu-gdpr:AdequacyDecision ;
	skos:inScheme dpv_linkml:dpv_legal .
dpv_linkml:DpvAgent dcterms:title "Agent" ;
	a owl:Class ;
	rdfs:label "DpvAgent" ;
	rdfs:subClassOf _:c14n1137 , _:c14n1181 , _:c14n153 , _:c14n155 , _:c14n25 , _:c14n424 , _:c14n482 , _:c14n528 , _:c14n719 , _:c14n752 , _:c14n839 , _:c14n885 , _:c14n974 , _:c14n995 ;
	skos:definition "A person or an organization DPV names as a contributor, as DPV's files describe them." ;
	skos:exactMatch dcterms:Agent ;
	skos:inScheme dpv_linkml:dpv_core .
dpv_linkml:DpvAgentNegotiationBehaviour dcterms:title "Agent Negotiation Behaviour" ;
	a owl:Class ;
	rdfs:label "DpvAgentNegotiationBehaviour" ;
	rdfs:subClassOf dpv_linkml:DpvContractualClause ;
	skos:definition "Term that indicates the behaviour of the Agent in relation to negotiations" ;
	skos:exactMatch ieee-7012:AgentNegotiationBehaviour ;
	skos:inScheme dpv_linkml:dpv_standards .
dpv_linkml:DpvAgentRequestBehaviour dcterms:title "Agent Request Behaviour" ;
	a owl:Class ;
	rdfs:label "DpvAgentRequestBehaviour" ;
	rdfs:subClassOf dpv_linkml:DpvContractualClause ;
	skos:definition "Term that indicates the behaviour of the Agent in relation to requests" ;
	skos:exactMatch ieee-7012:AgentRequestBehaviour ;
	skos:inScheme dpv_linkml:dpv_standards .
dpv_linkml:DpvAggregatedData dcterms:title "AggregatedData" ;
	a owl:Class ;
	rdfs:label "DpvAggregatedData" ;
	rdfs:subClassOf dpv_linkml:DpvConcept ;
	skos:definition "A kind of term DPV names as dpv:AggregatedData and does not define." ;
	skos:exactMatch dpv:AggregatedData ;
	skos:inScheme dpv_linkml:dpv_kinds .
dpv_linkml:DpvAgreement dcterms:title "Agreement" ;
	a owl:Class ;
	rdfs:label "DpvAgreement" ;
	rdfs:subClassOf dpv_linkml:DpvContractualClause ;
	skos:definition "A compound set of terms or clauses, proposed and offered before a formal contract between parties, and also referred to as a \"proposal\" pr \"proposed agreement\"" ;
	skos:exactMatch ieee-7012:Agreement ;
	skos:inScheme dpv_linkml:dpv_standards .
dpv_linkml:DpvAgreementNegotiationStatus dcterms:title "Agreement Negotiation Status" ;
	a owl:Class ;
	rdfs:label "DpvAgreementNegotiationStatus" ;
	rdfs:subClassOf dpv_linkml:DpvStatus ;
	skos:definition "Status associated with the Agreement Negotiation" ;
	skos:exactMatch ieee-7012:AgreementNegotiationStatus ;
	skos:inScheme dpv_linkml:dpv_standards .
dpv_linkml:DpvAiCapability dcterms:title "Capability" ;
	a owl:Class ;
	rdfs:label "DpvAiCapability" ;
	rdfs:subClassOf dpv_linkml:DpvTechnology ;
	skos:definition "Capability or use of AI to achieve a technical goal or objective" ;
	skos:exactMatch ai:Capability ;
	skos:inScheme dpv_linkml:dpv_ai .
dpv_linkml:DpvApplicability dcterms:title "Applicability" ;
	a owl:Class ;
	rdfs:label "DpvApplicability" ;
	rdfs:subClassOf dpv_linkml:DpvConcept ;
	skos:definition "Concept provided to represent indication of cases where the information or context is not applicable (N/A) or not available or this is not known or determined yet. If the information is applicable and available, this concept should not be used." ;
	skos:exactMatch dpv:Applicability ;
	skos:inScheme dpv_linkml:dpv_kinds .
dpv_linkml:DpvAuditStatus dcterms:title "Audit Status" ;
	a owl:Class ;
	rdfs:label "DpvAuditStatus" ;
	rdfs:subClassOf dpv_linkml:DpvStatus ;
	skos:definition "Status associated with Auditing or Investigation" ;
	skos:exactMatch dpv:AuditStatus ;
	skos:inScheme dpv_linkml:dpv_kinds .
dpv_linkml:DpvAuthority dcterms:title "Authority" ;
	a owl:Class ;
	rdfs:label "DpvAuthority" ;
	rdfs:subClassOf dpv_linkml:DpvLegalEntity ;
	skos:definition "An authority with the power to create or enforce laws, or determine their compliance." ;
	skos:exactMatch dpv:Authority ;
	skos:inScheme dpv_linkml:dpv_kinds .
dpv_linkml:DpvAutomationLevel dcterms:title "Automation Level" ;
	a owl:Class ;
	rdfs:label "DpvAutomationLevel" ;
	rdfs:subClassOf dpv_linkml:DpvProcessingContext ;
	skos:definition "Indication of degree or level of automation associated with specified context" ;
	skos:exactMatch dpv:AutomationLevel ;
	skos:inScheme dpv_linkml:dpv_kinds .
dpv_linkml:DpvAvailabilityConcept dcterms:title "Availability Concept" ;
	a owl:Class ;
	rdfs:label "DpvAvailabilityConcept" ;
	rdfs:subClassOf dpv_linkml:DpvRiskConcept ;
	skos:definition "Indicates a concept is relevant to 'Availability' in CIA InfoSec model" ;
	skos:exactMatch risk:AvailabilityConcept ;
	skos:inScheme dpv_linkml:dpv_risk .
dpv_linkml:DpvCatalogue dcterms:title "Catalogue" ;
	a owl:Class ;
	rdfs:label "DpvCatalogue" ;
	rdfs:subClassOf _:c14n1028 , _:c14n1048 , _:c14n1197 , _:c14n207 , _:c14n287 , _:c14n290 , _:c14n312 , _:c14n313 , _:c14n337 , _:c14n339 , _:c14n354 , _:c14n452 , _:c14n536 , _:c14n695 , _:c14n76 , _:c14n816 , _:c14n92 , _:c14n996 ;
	skos:definition "One part of a DPV release: one namespace family's vocabularies and terms, its contributors or its examples." ;
	skos:inScheme <https://w3id.org/lmodel/dpv> .
dpv_linkml:DpvChangeCategory dcterms:title "Change Category" ;
	a owl:Class ;
	rdfs:label "DpvChangeCategory" ;
	rdfs:subClassOf dpv_linkml:DpvConcept ;
	skos:definition "A categorisation of the change associated with the AI system" ;
	skos:exactMatch eu-aiact:ChangeCategory ;
	skos:inScheme dpv_linkml:dpv_legal .
dpv_linkml:DpvCommunicationMechanism dcterms:title "Communication Mechanism" ;
	a owl:Class ;
	rdfs:label "DpvCommunicationMechanism" ;
	rdfs:subClassOf dpv_linkml:DpvTechnology ;
	skos:definition "Communication mechanism used or provided by Technology" ;
	skos:exactMatch tech:CommunicationMechanism ;
	skos:inScheme dpv_linkml:dpv_tech .
dpv_linkml:DpvComplianceStatus dcterms:title "Compliance Status" ;
	a owl:Class ;
	rdfs:label "DpvComplianceStatus" ;
	rdfs:subClassOf dpv_linkml:DpvStatus ;
	skos:definition "Status associated with Compliance with some norms, objectives, or requirements" ;
	skos:exactMatch dpv:ComplianceStatus ;
	skos:inScheme dpv_linkml:dpv_kinds .
dpv_linkml:DpvConcept dcterms:title "Concept" ;
	a owl:Class ;
	rdfs:label "DpvConcept" ;
	rdfs:subClassOf dpv_linkml:DpvTerm , _:c14n1053 , _:c14n108 , _:c14n1101 , _:c14n1103 , _:c14n1121 , _:c14n1140 , _:c14n115 , _:c14n1164 , _:c14n1191 , _:c14n132 , _:c14n136 , _:c14n139 , _:c14n157 , _:c14n170 , _:c14n172 , _:c14n215 , _:c14n220 , _:c14n227 , _:c14n236 , _:c14n243 , _:c14n292 , _:c14n423 , _:c14n49 , _:c14n54 , _:c14n584 , _:c14n769 , _:c14n776 , _:c14n779 , _:c14n799 , _:c14n807 , _:c14n812 , _:c14n824 , _:c14n827 , _:c14n863 , _:c14n884 , _:c14n91 ;
	skos:definition "A term DPV states as a concept and a class. Its rdf_type names the concepts it is an instance of, each a class of this schema, where DPV states one." ;
	skos:exactMatch skos:Concept ;
	skos:inScheme dpv_linkml:dpv_terms ;
	skos:note "It holds the DPV properties some term of the vocabularies states. A thing a use case describes takes DpvResource, which holds them all." .
dpv_linkml:DpvConceptScheme dcterms:title "Concept Scheme" ;
	a owl:Class ;
	rdfs:label "DpvConceptScheme" ;
	rdfs:subClassOf _:c14n160 , _:c14n229 , _:c14n605 ;
	skos:definition "A list of terms DPV keeps within a vocabulary. DPV states nothing else about one." ;
	skos:exactMatch skos:ConceptScheme ;
	skos:inScheme dpv_linkml:dpv_core .
dpv_linkml:DpvConfidentialityConcept dcterms:title "Confidentiality Concept" ;
	a owl:Class ;
	rdfs:label "DpvConfidentialityConcept" ;
	rdfs:subClassOf dpv_linkml:DpvRiskConcept ;
	skos:definition "Indicates a concept is relevant to 'Confidentiality' in CIA InfoSec model" ;
	skos:exactMatch risk:ConfidentialityConcept ;
	skos:inScheme dpv_linkml:dpv_risk .
dpv_linkml:DpvConflictResolutionTerm dcterms:title "Conflict Resolution Term" ;
	a owl:Class ;
	rdfs:label "DpvConflictResolutionTerm" ;
	rdfs:subClassOf dpv_linkml:DpvContractualClause ;
	skos:definition "Term related to resolving conflicts in Term(s)" ;
	skos:exactMatch ieee-7012:ConflictResolutionTerm ;
	skos:inScheme dpv_linkml:dpv_standards .
dpv_linkml:DpvConformanceStatus dcterms:title "Conformance Status" ;
	a owl:Class ;
	rdfs:label "DpvConformanceStatus" ;
	rdfs:subClassOf dpv_linkml:DpvStatus ;
	skos:definition "Status associated with conformance to a standard, guideline, code, or recommendation" ;
	skos:exactMatch dpv:ConformanceStatus ;
	skos:inScheme dpv_linkml:dpv_kinds .
dpv_linkml:DpvConsentStatus dcterms:title "Consent Status" ;
	a owl:Class ;
	rdfs:label "DpvConsentStatus" ;
	rdfs:subClassOf dpv_linkml:DpvStatus ;
	skos:definition "The state or status of 'consent' that provides information reflecting its operational status and validity for processing data" ;
	skos:exactMatch dpv:ConsentStatus ;
	skos:inScheme dpv_linkml:dpv_kinds .
dpv_linkml:DpvContractActivationStatus dcterms:title "Contract Activation Status" ;
	a owl:Class ;
	rdfs:label "DpvContractActivationStatus" ;
	rdfs:subClassOf dpv_linkml:DpvStatus ;
	skos:definition "Status associated with activation of a contract i.e. whether its terms are active and are required to be performed" ;
	skos:exactMatch dpv:ContractActivationStatus ;
	skos:inScheme dpv_linkml:dpv_kinds .
dpv_linkml:DpvContractExecutionStatus dcterms:title "Contract Execution Status" ;
	a owl:Class ;
	rdfs:label "DpvContractExecutionStatus" ;
	rdfs:subClassOf dpv_linkml:DpvStatus ;
	skos:definition "Status associated with execution of a contract (i.e. signing and procedural aspects before the contract terms come in to effect)" ;
	skos:exactMatch dpv:ContractExecutionStatus ;
	skos:inScheme dpv_linkml:dpv_kinds .
dpv_linkml:DpvContractFulfilmentStatus dcterms:title "Contract Fulfilment Status" ;
	a owl:Class ;
	rdfs:label "DpvContractFulfilmentStatus" ;
	rdfs:subClassOf dpv_linkml:DpvStatus ;
	skos:definition "Status associated with fulfilment of a contract" ;
	skos:exactMatch dpv:ContractFulfilmentStatus ;
	skos:inScheme dpv_linkml:dpv_kinds .
dpv_linkml:DpvContractPerformanceStatus dcterms:title "Contract Performance Status" ;
	a owl:Class ;
	rdfs:label "DpvContractPerformanceStatus" ;
	rdfs:subClassOf dpv_linkml:DpvStatus ;
	skos:definition "Status associated with performance of a contract" ;
	skos:exactMatch dpv:ContractPerformanceStatus ;
	skos:inScheme dpv_linkml:dpv_kinds .
dpv_linkml:DpvContractPreparationStatus dcterms:title "Contract Preparation Status" ;
	a owl:Class ;
	rdfs:label "DpvContractPreparationStatus" ;
	rdfs:subClassOf dpv_linkml:DpvStatus ;
	skos:definition "Status associated with preparation of contracts before they are signed or accepted or executed" ;
	skos:exactMatch dpv:ContractPreparationStatus ;
	skos:inScheme dpv_linkml:dpv_kinds .
dpv_linkml:DpvContractTerminationStatus dcterms:title "Contract Termination Status" ;
	a owl:Class ;
	rdfs:label "DpvContractTerminationStatus" ;
	rdfs:subClassOf dpv_linkml:DpvStatus ;
	skos:definition "Status associated with termination of a contract" ;
	skos:exactMatch dpv:ContractTerminationStatus ;
	skos:inScheme dpv_linkml:dpv_kinds .
dpv_linkml:DpvContractualClause dcterms:title "Contractual Clause" ;
	a owl:Class ;
	rdfs:label "DpvContractualClause" ;
	rdfs:subClassOf dpv_linkml:DpvConcept ;
	skos:definition "A part or component within a contract that outlines its specifics" ;
	skos:exactMatch dpv:ContractualClause ;
	skos:inScheme dpv_linkml:dpv_kinds .
dpv_linkml:DpvContractualClauseFulfilmentStatus dcterms:title "Contractual Clause Fulfilment Status" ;
	a owl:Class ;
	rdfs:label "DpvContractualClauseFulfilmentStatus" ;
	rdfs:subClassOf dpv_linkml:DpvStatus ;
	skos:definition "Status associated with fulfilment of a contractual clause" ;
	skos:exactMatch dpv:ContractualClauseFulfilmentStatus ;
	skos:inScheme dpv_linkml:dpv_kinds .
dpv_linkml:DpvCountry dcterms:title "Country" ;
	a owl:Class ;
	rdfs:label "DpvCountry" ;
	rdfs:subClassOf dpv_linkml:DpvJurisdiction ;
	skos:definition "A political entity indicative of a sovereign or non-sovereign territorial state comprising of distinct geographical areas" ;
	skos:exactMatch dpv:Country ;
	skos:inScheme dpv_linkml:dpv_kinds .
dpv_linkml:DpvDBIARiskStatus dcterms:title "DBIA Risk Status" ;
	a owl:Class ;
	rdfs:label "DpvDBIARiskStatus" ;
	rdfs:subClassOf dpv_linkml:DpvAuditStatus ;
	skos:definition "Status reflecting the status of risk associated with a DBIA regarding rights and freedoms of natural persons" ;
	skos:exactMatch eu-gdpr:DBIARiskStatus ;
	skos:inScheme dpv_linkml:dpv_legal .
dpv_linkml:DpvDPIAConformity dcterms:title "DPIA Conformity" ;
	a owl:Class ;
	rdfs:label "DpvDPIAConformity" ;
	rdfs:subClassOf dpv_linkml:DpvConformanceStatus ;
	skos:definition "Conformity of a process with a DPIA" ;
	skos:exactMatch eu-gdpr:DPIAConformity ;
	skos:inScheme dpv_linkml:dpv_legal .
dpv_linkml:DpvDPIANecessityStatus dcterms:title "DPIA Necessity Status" ;
	a owl:Class ;
	rdfs:label "DpvDPIANecessityStatus" ;
	rdfs:subClassOf dpv_linkml:DpvAuditStatus ;
	skos:definition "Status reflecting whether a DPIA is necessary" ;
	skos:exactMatch eu-gdpr:DPIANecessityStatus ;
	skos:inScheme dpv_linkml:dpv_legal .
dpv_linkml:DpvDPIAOutcomeStatus dcterms:title "DPIA Outcome Status" ;
	a owl:Class ;
	rdfs:label "DpvDPIAOutcomeStatus" ;
	rdfs:subClassOf dpv_linkml:DpvAuditStatus ;
	skos:definition "Status reflecting the outcomes of a DPIA" ;
	skos:exactMatch eu-gdpr:DPIAOutcomeStatus ;
	skos:inScheme dpv_linkml:dpv_legal .
dpv_linkml:DpvDPIAProcessingRecommendation dcterms:title "DPIA Processing Recommendation" ;
	a owl:Class ;
	rdfs:label "DpvDPIAProcessingRecommendation" ;
	rdfs:subClassOf dpv_linkml:DpvAuditStatus ;
	skos:definition "Recommendation from the DPIA regarding processing" ;
	skos:exactMatch eu-gdpr:DPIAProcessingRecommendation ;
	skos:inScheme dpv_linkml:dpv_legal .
dpv_linkml:DpvDPIARiskStatus dcterms:title "DPIA Risk Status" ;
	a owl:Class ;
	rdfs:label "DpvDPIARiskStatus" ;
	rdfs:subClassOf dpv_linkml:DpvAuditStatus ;
	skos:definition "Status reflecting the status of risk associated with a DPIA" ;
	skos:exactMatch eu-gdpr:DPIARiskStatus ;
	skos:inScheme dpv_linkml:dpv_legal .
dpv_linkml:DpvDataBreachNotice dcterms:title "Data Breach Notice" ;
	a owl:Class ;
	rdfs:label "DpvDataBreachNotice" ;
	rdfs:subClassOf dpv_linkml:DpvOrganisationalMeasure ;
	skos:definition "Notice associated with data breach providing information in compliance with GDPR" ;
	skos:exactMatch eu-gdpr:DataBreachNotice ;
	skos:inScheme dpv_linkml:dpv_legal .
dpv_linkml:DpvDataBreachNoticeRequirement dcterms:title "Data Breach Notice Requirement" ;
	a owl:Class ;
	rdfs:label "DpvDataBreachNoticeRequirement" ;
	rdfs:subClassOf dpv_linkml:DpvAuditStatus ;
	skos:definition "Whether a Data Breach notification is required" ;
	skos:exactMatch eu-gdpr:DataBreachNoticeRequirement ;
	skos:inScheme dpv_linkml:dpv_legal .
dpv_linkml:DpvDataDeletionTerm dcterms:title "Data Deletion Term" ;
	a owl:Class ;
	rdfs:label "DpvDataDeletionTerm" ;
	rdfs:subClassOf dpv_linkml:DpvContractualClause ;
	skos:definition "Term that indicates deletion regarding data as an obligation" ;
	skos:exactMatch ieee-7012:DataDeletionTerm ;
	skos:inScheme dpv_linkml:dpv_standards .
dpv_linkml:DpvDataProtectionAuthority dcterms:title "Data Protection Authority" ;
	a owl:Class ;
	rdfs:label "DpvDataProtectionAuthority" ;
	rdfs:subClassOf dpv_linkml:DpvAuthority ;
	skos:definition "An authority tasked with overseeing legal compliance regarding privacy and data protection laws." ;
	skos:exactMatch dpv:DataProtectionAuthority ;
	skos:inScheme dpv_linkml:dpv_kinds .
dpv_linkml:DpvDataSharingTerm dcterms:title "Data Sharing Term" ;
	a owl:Class ;
	rdfs:label "DpvDataSharingTerm" ;
	rdfs:subClassOf dpv_linkml:DpvContractualClause ;
	skos:definition "Term related to Data Sharing" ;
	skos:exactMatch ieee-7012:DataSharingTerm ;
	skos:inScheme dpv_linkml:dpv_standards .
dpv_linkml:DpvDataSource dcterms:title "Data Source" ;
	a owl:Class ;
	rdfs:label "DpvDataSource" ;
	rdfs:subClassOf dpv_linkml:DpvProcessingContext ;
	skos:definition "The source or origin of data" ;
	skos:exactMatch dpv:DataSource ;
	skos:inScheme dpv_linkml:dpv_kinds .
dpv_linkml:DpvDataSubjectDataSource dcterms:title "Data Subject as Data Source" ;
	a owl:Class ;
	rdfs:label "DpvDataSubjectDataSource" ;
	rdfs:subClassOf dpv_linkml:DpvDataSource ;
	skos:definition "Data Sourced from Data Subject(s), e.g. when data is collected via a form or observed from their activities" ;
	skos:exactMatch dpv:DataSubjectDataSource ;
	skos:inScheme dpv_linkml:dpv_kinds .
dpv_linkml:DpvDataSubjectScale dcterms:title "Data Subject Scale" ;
	a owl:Class ;
	rdfs:label "DpvDataSubjectScale" ;
	rdfs:subClassOf dpv_linkml:DpvProcessingContext ;
	skos:definition "Scale of Data Subject(s)" ;
	skos:exactMatch dpv:DataSubjectScale ;
	skos:inScheme dpv_linkml:dpv_kinds .
