dpv_linkml:DpvStatus dcterms:title "Status" ;
	a owl:Class ;
	rdfs:label "DpvStatus" ;
	rdfs:subClassOf dpv_linkml:DpvConcept ;
	skos:definition "The status or state of something" ;
	skos:exactMatch dpv:Status ;
