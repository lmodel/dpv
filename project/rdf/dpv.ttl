<https://w3id.org/lmodel/dpv/valid> dcterms:title "dct:valid" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/dpv/dpv_terms"^^xsd:anyURI ;
	skos:mappingRelation "http://purl.org/dc/terms/valid"^^xsd:anyURI ;
	skos:note "Also used for specifying the temporal validity of an activity associated with Right Exercise. For example, limits on duration for providing or accessing provided information" , "For expressing the temporal date or range of validity of the DPIA document or process. This refers to the time period for which the DPIA is considered valid, and does not refer to the temporal period associated with processing (see dct:temporal instead). The assumption is that after this period, the DPIA should be re-evaluated or some process should be triggered" ;
	linkml:definition_uri "https://w3id.org/lmodel/dpv/valid"^^xsd:anyURI ;
	linkml:description "The property dcterms:valid." ;
	linkml:domain_of <https://w3id.org/lmodel/dpv/DpvResource> ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/dpv/DpvResource> ;
