    (  $<DpvDPIAProcessingRecommendation_tes> (  &<DpvAuditStatus_tes> ;
          rdf:type [ dpv:AuditStatus ] ?
       ) ;
       rdf:type [ eu-gdpr:DPIAProcessingRecommendation ]
    )
}

