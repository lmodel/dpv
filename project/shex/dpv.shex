       rdf:type [ dpv:EntityPermissiveInvolvement ]
    )
}

<DpvEuAiactMarketAvailabilityStatus> CLOSED {
    (  $<DpvEuAiactMarketAvailabilityStatus_tes> (  &<DpvTechMarketAvailabilityStatus_tes> ;
          rdf:type [ tech:MarketAvailabilityStatus ] ?
       ) ;
       rdf:type [ eu-aiact:MarketAvailabilityStatus ]
    )
}

