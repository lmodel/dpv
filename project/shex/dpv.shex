    (  $<DpvDPIARiskStatus_tes> (  &<DpvAuditStatus_tes> ;
          rdf:type [ dpv:AuditStatus ] ?
       ) ;
       rdf:type [ eu-gdpr:DPIARiskStatus ]
    )
}

<DpvDuration> CLOSED {
    (  $<DpvDuration_tes> (  &<DpvConcept_tes> ;
          rdf:type [ skos:Concept ] ?
       ) ;
       rdf:type [ dpv:Duration ]
    )
}

<DpvEntityInformedStatus> CLOSED {
    (  $<DpvEntityInformedStatus_tes> (  &<DpvStatus_tes> ;
          rdf:type [ dpv:Status ] ?
       ) ;
       rdf:type [ dpv:EntityInformedStatus ]
    )
}

<DpvEntityInvolvementStatus> CLOSED {
    (  $<DpvEntityInvolvementStatus_tes> (  &<DpvStatus_tes> ;
          rdf:type [ dpv:Status ] ?
