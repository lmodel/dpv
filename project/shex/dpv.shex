    (  $<DpvEuGdprDataProtectionAuthority_tes> (  &<DpvDataProtectionAuthority_tes> ;
          rdf:type [ dpv:DataProtectionAuthority ] ?
       ) ;
       rdf:type [ eu-gdpr:DataProtectionAuthority ]
    )
}

