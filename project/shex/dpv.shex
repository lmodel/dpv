# metamodel_version: 1.12.0
# version: 2.3
BASE <https://w3id.org/lmodel/dpv/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX dcam: <http://purl.org/dc/dcam/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX org: <http://www.w3.org/ns/org#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX time: <http://www.w3.org/2006/time#>
PREFIX vann: <http://purl.org/vocab/vann/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX ai: <https://w3id.org/dpv/ai#>
PREFIX bibo: <http://purl.org/ontology/bibo/>
PREFIX de-gdng: <https://w3id.org/dpv/legal/de/gdng#>
PREFIX dex: <https://w3id.org/dpv/examples#>
PREFIX dpv: <https://w3id.org/dpv#>
PREFIX eu-aiact: <https://w3id.org/dpv/legal/eu/aiact#>
PREFIX eu-dga: <https://w3id.org/dpv/legal/eu/dga#>
PREFIX eu-gdpr: <https://w3id.org/dpv/legal/eu/gdpr#>
PREFIX ieee-7012: <https://w3id.org/dpv/standards/ieee/7012#>
PREFIX linkml: <https://w3id.org/linkml/>
PREFIX loc: <https://w3id.org/dpv/loc#>
PREFIX pd: <https://w3id.org/dpv/pd#>
PREFIX risk: <https://w3id.org/dpv/risk#>
PREFIX scoro: <http://purl.org/spar/scoro/>
PREFIX sdo: <https://schema.org/>
PREFIX sector-health: <https://w3id.org/dpv/sector/health#>
PREFIX sw: <http://www.w3.org/2003/06/sw-vocab-status/ns#>
PREFIX tech: <https://w3id.org/dpv/tech#>
PREFIX prof: <http://www.w3.org/ns/dx/prof/>


linkml:String xsd:string

linkml:Integer xsd:integer

linkml:Boolean xsd:boolean

linkml:Float xsd:float

linkml:Double xsd:double

linkml:Decimal xsd:decimal

linkml:Time xsd:time

linkml:Date xsd:date

linkml:Datetime xsd:dateTime

linkml:DateOrDatetime linkml:DateOrDatetime

linkml:Uriorcurie IRI

linkml:Curie xsd:string

linkml:Uri IRI

linkml:Ncname xsd:string

linkml:Objectidentifier IRI

linkml:Nodeidentifier NONLITERAL

linkml:Jsonpointer xsd:string

linkml:Jsonpath xsd:string

linkml:Sparqlpath xsd:string

<DpvDate> xsd:date

<DpvUri> IRI

<DpvActivityStatus> CLOSED {
    (  $<DpvActivityStatus_tes> (  &<DpvStatus_tes> ;
          rdf:type [ dpv:Status ] ?
       ) ;
       rdf:type [ dpv:ActivityStatus ]
    )
}

<DpvActor> CLOSED {
    (  $<DpvActor_tes> (  &<DpvConcept_tes> ;
          rdf:type [ skos:Concept ] ?
       ) ;
       rdf:type [ tech:Actor ]
    )
}

<DpvAdequacyDecision> CLOSED {
    (  $<DpvAdequacyDecision_tes> (  &<DpvLegalBasis_tes> ;
          rdf:type [ dpv:LegalBasis ] ?
       ) ;
       rdf:type [ eu-gdpr:AdequacyDecision ]
    )
}

<DpvAgent> CLOSED {
    (  $<DpvAgent_tes> (  foaf:name @linkml:String ;
          foaf:homepage @linkml:String ? ;
          org:memberOf @<DpvAgent> * ;
          scoro:hasORCID @linkml:String ?
       ) ;
       rdf:type [ dcterms:Agent ]
    )
}

<DpvAgentNegotiationBehaviour> CLOSED {
    (  $<DpvAgentNegotiationBehaviour_tes> (  &<DpvContractualClause_tes> ;
          rdf:type [ dpv:ContractualClause ] ?
       ) ;
       rdf:type [ ieee-7012:AgentNegotiationBehaviour ]
    )
}

<DpvAgentRequestBehaviour> CLOSED {
    (  $<DpvAgentRequestBehaviour_tes> (  &<DpvContractualClause_tes> ;
          rdf:type [ dpv:ContractualClause ] ?
       ) ;
       rdf:type [ ieee-7012:AgentRequestBehaviour ]
    )
}

<DpvAggregatedData> CLOSED {
    (  $<DpvAggregatedData_tes> (  &<DpvConcept_tes> ;
          rdf:type [ skos:Concept ] ?
       ) ;
       rdf:type [ dpv:AggregatedData ]
    )
}

<DpvAgreement> CLOSED {
    (  $<DpvAgreement_tes> (  &<DpvContractualClause_tes> ;
          rdf:type [ dpv:ContractualClause ] ?
       ) ;
       rdf:type [ ieee-7012:Agreement ]
    )
}

<DpvAgreementNegotiationStatus> CLOSED {
    (  $<DpvAgreementNegotiationStatus_tes> (  &<DpvStatus_tes> ;
          rdf:type [ dpv:Status ] ?
       ) ;
       rdf:type [ ieee-7012:AgreementNegotiationStatus ]
    )
}

<DpvAiCapability> CLOSED {
    (  $<DpvAiCapability_tes> (  &<DpvTechnology_tes> ;
          rdf:type [ dpv:Technology ] ?
       ) ;
       rdf:type [ ai:Capability ]
    )
}

<DpvAISystem>  (
    CLOSED {
       (  $<DpvAISystem_tes> (  &<DpvTechnology_tes> ;
             rdf:type [ dpv:Technology ] ?
          ) ;
          rdf:type [ eu-aiact:AISystem ]
       )
    } OR @<DpvHighRiskAISystem> OR @<DpvProhibitedAISystem>
)

<DpvApplicability> CLOSED {
    (  $<DpvApplicability_tes> (  &<DpvConcept_tes> ;
          rdf:type [ skos:Concept ] ?
       ) ;
       rdf:type [ dpv:Applicability ]
    )
}

<DpvAuditStatus>  (
    CLOSED {
       (  $<DpvAuditStatus_tes> (  &<DpvStatus_tes> ;
             rdf:type [ dpv:Status ] ?
          ) ;
          rdf:type [ dpv:AuditStatus ]
       )
    } OR @<DpvDBIARiskStatus> OR @<DpvDPIANecessityStatus> OR @<DpvDPIAOutcomeStatus> OR @<DpvDPIAProcessingRecommendation> OR
    @<DpvDPIARiskStatus> OR @<DpvDataBreachNoticeRequirement>
)

<DpvAuthority>  (
    CLOSED {
       (  $<DpvAuthority_tes> (  &<DpvLegalEntity_tes> ;
             rdf:type [ dpv:LegalEntity ] ?
          ) ;
          rdf:type [ dpv:Authority ]
       )
    } OR @<DpvDataProtectionAuthority>
)

<DpvAutomationLevel> CLOSED {
    (  $<DpvAutomationLevel_tes> (  &<DpvProcessingContext_tes> ;
          rdf:type [ dpv:ProcessingContext ] ?
       ) ;
       rdf:type [ dpv:AutomationLevel ]
    )
}

<DpvAvailabilityConcept> CLOSED {
    (  $<DpvAvailabilityConcept_tes> (  &<DpvRiskConcept_tes> ;
          rdf:type [ dpv:RiskConcept ] ?
       ) ;
       rdf:type [ risk:AvailabilityConcept ]
    )
}

<DpvCatalogue> CLOSED {
    (  $<DpvCatalogue_tes> (  <concepts> @<DpvConcept> * ;
          dcterms:isVersionOf @linkml:String ;
          <family> [ <https://w3id.org/lmodel/dpv/DpvFamily#core> <https://w3id.org/lmodel/dpv/DpvFamily#pd>
             <https://w3id.org/lmodel/dpv/DpvFamily#tech> <https://w3id.org/lmodel/dpv/DpvFamily#ai>
             <https://w3id.org/lmodel/dpv/DpvFamily#risk> <https://w3id.org/lmodel/dpv/DpvFamily#justifications>
             <https://w3id.org/lmodel/dpv/DpvFamily#loc> <https://w3id.org/lmodel/dpv/DpvFamily#legal>
             <https://w3id.org/lmodel/dpv/DpvFamily#sector> <https://w3id.org/lmodel/dpv/DpvFamily#standards>
             <https://w3id.org/lmodel/dpv/DpvFamily#agents> <https://w3id.org/lmodel/dpv/DpvFamily#examples> ] ;
          <vocabularies> @<DpvVocabulary> * ;
          <concept_schemes> @<DpvConceptScheme> * ;
          <properties> @<DpvProperty> * ;
          <agents> @<DpvAgent> * ;
          <examples> @<DpvExample> *
       ) ;
       rdf:type [ <DpvCatalogue> ] ?
    )
}

<DpvChangeCategory> CLOSED {
    (  $<DpvChangeCategory_tes> (  &<DpvConcept_tes> ;
          rdf:type [ skos:Concept ] ?
       ) ;
       rdf:type [ eu-aiact:ChangeCategory ]
    )
}

<DpvCommunicationMechanism> CLOSED {
    (  $<DpvCommunicationMechanism_tes> (  &<DpvTechnology_tes> ;
          rdf:type [ dpv:Technology ] ?
       ) ;
       rdf:type [ tech:CommunicationMechanism ]
    )
}

<DpvComplianceStatus>  (
    CLOSED {
       (  $<DpvComplianceStatus_tes> (  &<DpvStatus_tes> ;
             rdf:type [ dpv:Status ] ?
          ) ;
          rdf:type [ dpv:ComplianceStatus ]
       )
    } OR @<DpvLawfulness>
)

<DpvConcept>  (
    CLOSED {
       (  $<DpvConcept_tes> (  &<DpvTerm_tes> ;
             rdf:type [ <DpvTerm> ] ? ;
             eu-aiact:hasRiskLevel @<DpvTerm> * ;
             dpv:hasApplicableLaw @<DpvTerm> * ;
             dpv:hasAuthority @<DpvTerm> * ;
             ieee-7012:hasHumanDescription @linkml:String * ;
             dpv:hasInverseJurisdiction @<DpvTerm> * ;
             dpv:hasJurisdiction @<DpvTerm> * ;
             dpv:hasJustification @<DpvTerm> * ;
             dpv:hasLikelihood @<DpvTerm> * ;
             dpv:hasObligation @<DpvTerm> * ;
             dpv:hasPermission @<DpvTerm> * ;
             dpv:hasProhibition @<DpvTerm> * ;
             dpv:hasRight @<DpvTerm> * ;
             dpv:hasRiskLevel @<DpvTerm> * ;
             dpv:hasSeverity @<DpvTerm> * ;
             loc:iso_alpha2 @linkml:String * ;
             loc:iso_alpha3 @linkml:String * ;
             loc:iso_numeric @linkml:String * ;
             loc:un_m49 @linkml:String *
          ) ;
          rdf:type [ skos:Concept ]
       )
    } OR @<DpvActor> OR @<DpvAggregatedData> OR @<DpvApplicability> OR @<DpvChangeCategory> OR @<DpvContractualClause> OR
    @<DpvDocumentation> OR @<DpvDuration> OR @<DpvExpectationStatus> OR @<DpvFeeRequirement> OR @<DpvFrequency> OR @<DpvImportance>
    OR @<DpvJustification> OR @<DpvLaw> OR @<DpvLegalBasis> OR @<DpvLegalEntity> OR @<DpvLegalMeasure> OR @<DpvLifecycleStage> OR
    @<DpvLikelihood> OR @<DpvLocation> OR @<DpvLocationFixture> OR @<DpvNecessity> OR @<DpvNonPersonalData> OR
    @<DpvOrganisationalMeasure> OR @<DpvPdPersonalData> OR @<DpvPersonalData> OR @<DpvPhysicalMeasure> OR @<DpvProcessing> OR
    @<DpvProcessingContext> OR @<DpvPublicRegisterOfEntities> OR @<DpvPurpose> OR @<DpvRegulatedHealthDataHolder> OR @<DpvRight> OR
    @<DpvRiskAnalysis> OR @<DpvRiskConcept> OR @<DpvRiskControl> OR @<DpvRiskLevel> OR @<DpvRule> OR @<DpvSector> OR @<DpvSeverity>
    OR @<DpvStatus> OR @<DpvTechCapability> OR @<DpvTechnicalMeasure> OR @<DpvTechnology>
)

<DpvConceptScheme> CLOSED {
    (  $<DpvConceptScheme_tes> rdf:type . * ;
       rdf:type [ skos:ConceptScheme ]
    )
}

<DpvConfidentialityConcept> CLOSED {
    (  $<DpvConfidentialityConcept_tes> (  &<DpvRiskConcept_tes> ;
          rdf:type [ dpv:RiskConcept ] ?
       ) ;
       rdf:type [ risk:ConfidentialityConcept ]
    )
}

<DpvConflictResolutionTerm> CLOSED {
    (  $<DpvConflictResolutionTerm_tes> (  &<DpvContractualClause_tes> ;
          rdf:type [ dpv:ContractualClause ] ?
       ) ;
       rdf:type [ ieee-7012:ConflictResolutionTerm ]
    )
}

<DpvConformanceStatus>  (
    CLOSED {
       (  $<DpvConformanceStatus_tes> (  &<DpvStatus_tes> ;
             rdf:type [ dpv:Status ] ?
          ) ;
          rdf:type [ dpv:ConformanceStatus ]
       )
    } OR @<DpvDPIAConformity>
)

<DpvConsentStatus> CLOSED {
    (  $<DpvConsentStatus_tes> (  &<DpvStatus_tes> ;
          rdf:type [ dpv:Status ] ?
       ) ;
       rdf:type [ dpv:ConsentStatus ]
    )
}

<DpvContractActivationStatus> CLOSED {
    (  $<DpvContractActivationStatus_tes> (  &<DpvStatus_tes> ;
          rdf:type [ dpv:Status ] ?
       ) ;
       rdf:type [ dpv:ContractActivationStatus ]
    )
}

<DpvContractExecutionStatus> CLOSED {
    (  $<DpvContractExecutionStatus_tes> (  &<DpvStatus_tes> ;
          rdf:type [ dpv:Status ] ?
       ) ;
       rdf:type [ dpv:ContractExecutionStatus ]
    )
}

<DpvContractFulfilmentStatus> CLOSED {
    (  $<DpvContractFulfilmentStatus_tes> (  &<DpvStatus_tes> ;
          rdf:type [ dpv:Status ] ?
       ) ;
       rdf:type [ dpv:ContractFulfilmentStatus ]
    )
}

<DpvContractPerformanceStatus> CLOSED {
    (  $<DpvContractPerformanceStatus_tes> (  &<DpvStatus_tes> ;
          rdf:type [ dpv:Status ] ?
       ) ;
       rdf:type [ dpv:ContractPerformanceStatus ]
    )
}

<DpvContractPreparationStatus> CLOSED {
    (  $<DpvContractPreparationStatus_tes> (  &<DpvStatus_tes> ;
          rdf:type [ dpv:Status ] ?
       ) ;
       rdf:type [ dpv:ContractPreparationStatus ]
    )
}

<DpvContractTerminationStatus> CLOSED {
    (  $<DpvContractTerminationStatus_tes> (  &<DpvStatus_tes> ;
          rdf:type [ dpv:Status ] ?
       ) ;
       rdf:type [ dpv:ContractTerminationStatus ]
    )
}

<DpvContractualClause>  (
    CLOSED {
       (  $<DpvContractualClause_tes> (  &<DpvConcept_tes> ;
             rdf:type [ skos:Concept ] ?
          ) ;
          rdf:type [ dpv:ContractualClause ]
       )
    } OR @<DpvAgentNegotiationBehaviour> OR @<DpvAgentRequestBehaviour> OR @<DpvAgreement> OR @<DpvConflictResolutionTerm> OR
    @<DpvDataDeletionTerm> OR @<DpvDataSharingTerm> OR @<DpvDeonticInterpretationTerm> OR @<DpvPortabilityTerm> OR
    @<DpvPreferenceApplicability> OR @<DpvProfilingTerm> OR @<DpvTrackingTerm> OR @<DpvTransparencyTerm>
)

<DpvContractualClauseFulfilmentStatus> CLOSED {
    (  $<DpvContractualClauseFulfilmentStatus_tes> (  &<DpvStatus_tes> ;
          rdf:type [ dpv:Status ] ?
       ) ;
       rdf:type [ dpv:ContractualClauseFulfilmentStatus ]
    )
}

<DpvCountry>  (
    CLOSED {
       (  $<DpvCountry_tes> (  &<DpvJurisdiction_tes> ;
             rdf:type [ dpv:Jurisdiction ] ?
          ) ;
          rdf:type [ dpv:Country ]
       )
    } OR @<DpvRegion>
)

<DpvDataBreachNotice> CLOSED {
    (  $<DpvDataBreachNotice_tes> (  &<DpvOrganisationalMeasure_tes> ;
          rdf:type [ dpv:OrganisationalMeasure ] ?
       ) ;
       rdf:type [ eu-gdpr:DataBreachNotice ]
    )
}

<DpvDataBreachNoticeRequirement> CLOSED {
    (  $<DpvDataBreachNoticeRequirement_tes> (  &<DpvAuditStatus_tes> ;
          rdf:type [ dpv:AuditStatus ] ?
       ) ;
       rdf:type [ eu-gdpr:DataBreachNoticeRequirement ]
    )
}

<DpvDataDeletionTerm> CLOSED {
    (  $<DpvDataDeletionTerm_tes> (  &<DpvContractualClause_tes> ;
          rdf:type [ dpv:ContractualClause ] ?
       ) ;
       rdf:type [ ieee-7012:DataDeletionTerm ]
    )
}

<DpvDataProtectionAuthority>  (
    CLOSED {
       (  $<DpvDataProtectionAuthority_tes> (  &<DpvAuthority_tes> ;
             rdf:type [ dpv:Authority ] ?
          ) ;
          rdf:type [ dpv:DataProtectionAuthority ]
       )
    } OR @<DpvEuGdprDataProtectionAuthority>
)

<DpvDataSharingTerm> CLOSED {
    (  $<DpvDataSharingTerm_tes> (  &<DpvContractualClause_tes> ;
          rdf:type [ dpv:ContractualClause ] ?
       ) ;
       rdf:type [ ieee-7012:DataSharingTerm ]
    )
}

<DpvDataSource>  (
    CLOSED {
       (  $<DpvDataSource_tes> (  &<DpvProcessingContext_tes> ;
             rdf:type [ dpv:ProcessingContext ] ?
          ) ;
          rdf:type [ dpv:DataSource ]
       )
    } OR @<DpvDataSubjectDataSource>
)

<DpvDataSubjectDataSource> CLOSED {
    (  $<DpvDataSubjectDataSource_tes> (  &<DpvDataSource_tes> ;
          rdf:type [ dpv:DataSource ] ?
       ) ;
