    (  $<DpvDBIARiskStatus_tes> (  &<DpvAuditStatus_tes> ;
          rdf:type [ dpv:AuditStatus ] ?
       ) ;
       rdf:type [ eu-gdpr:DBIARiskStatus ]
    )
}

<DpvDeonticInterpretationTerm> CLOSED {
    (  $<DpvDeonticInterpretationTerm_tes> (  &<DpvContractualClause_tes> ;
          rdf:type [ dpv:ContractualClause ] ?
       ) ;
       rdf:type [ ieee-7012:DeonticInterpretationTerm ]
    )
}

<DpvDocumentation> CLOSED {
    (  $<DpvDocumentation_tes> (  &<DpvConcept_tes> ;
          rdf:type [ skos:Concept ] ?
       ) ;
       rdf:type [ tech:Documentation ]
    )
}

<DpvDPIAConformity> CLOSED {
    (  $<DpvDPIAConformity_tes> (  &<DpvConformanceStatus_tes> ;
          rdf:type [ dpv:ConformanceStatus ] ?
       ) ;
       rdf:type [ eu-gdpr:DPIAConformity ]
    )
}

