    (  $<DpvDataTransparencyTerm_tes> (  &<DpvTransparencyTerm_tes> ;
          rdf:type [ ieee-7012:TransparencyTerm ] ?
       ) ;
       rdf:type [ ieee-7012:DataTransparencyTerm ]
