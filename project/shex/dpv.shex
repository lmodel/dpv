    (  $<DpvEuGdprProcessing_tes> (  &<DpvProcessing_tes> ;
          rdf:type [ dpv:Processing ] ?
       ) ;
       rdf:type [ eu-gdpr:Processing ]
    )
}

<DpvEvaluationScoring>  (
    CLOSED {
       (  $<DpvEvaluationScoring_tes> (  &<DpvProcessingContext_tes> ;
             rdf:type [ dpv:ProcessingContext ] ?
          ) ;
          rdf:type [ dpv:EvaluationScoring ]
       )
    } OR @<DpvScoringOfIndividuals>
)

<DpvExample> CLOSED {
    (  $<DpvExample_tes> (  dcterms:title @linkml:String ;
          dcterms:description @linkml:String ? ;
          dcterms:format @linkml:String * ;
          dcterms:source @linkml:String * ;
          dcterms:subject @<DpvTerm> * ;
          dcterms:created @<DpvDate> * ;
          dcterms:modified @<DpvDate> ? ;
          dcterms:temporal @<DpvInterval> ? ;
          dcterms:contributor @<DpvAgent> * ;
          sw:term_status [ <https://w3id.org/lmodel/dpv/DpvTermStatus#accepted>
             <https://w3id.org/lmodel/dpv/DpvTermStatus#modified> <https://w3id.org/lmodel/dpv/DpvTermStatus#sunset> ] ? ;
          <turtle_fault> @linkml:String ? ;
          <resources> @<DpvResource> *
       ) ;
       rdf:type [ dex:Example ]
    )
}

<DpvExpectationStatus> CLOSED {
