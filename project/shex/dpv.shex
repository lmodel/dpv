<DpvTerm>  (
    @<DpvConcept> OR @<DpvProperty> OR @<DpvResource>
)

<DpvTerm_struct> {
    (  $<DpvTerm_tes> (  rdf:type @<DpvTerm> * ;
          skos:prefLabel @linkml:String ? ;
          skos:prefLabel @linkml:String ? ;
          skos:definition @linkml:String ? ;
          skos:definition @linkml:String ? ;
          skos:scopeNote @linkml:String * ;
          skos:broader @<DpvTerm> * ;
          skos:related @<DpvTerm> * ;
          skos:inScheme @<DpvConceptScheme> * ;
          skos:sameAs @<DpvTerm> * ;
          rdfs:isDefinedBy @<DpvVocabulary> * ;
          rdfs:subClassOf @<DpvTerm> * ;
          vann:example @<DpvExample> * ;
          skos:exactMatch @<DpvUri> * ;
          sw:term_status [ <https://w3id.org/lmodel/dpv/DpvTermStatus#accepted>
             <https://w3id.org/lmodel/dpv/DpvTermStatus#modified> <https://w3id.org/lmodel/dpv/DpvTermStatus#sunset> ] ? ;
          dcterms:created @<DpvDate> * ;
          dcterms:modified @<DpvDate> ? ;
          dcterms:contributor @<DpvAgent> * ;
          dcterms:source @linkml:String * ;
          dcterms:source @<DpvWebPage> * ;
          foaf:homepage @linkml:String ? ;
          rdf:value @linkml:Decimal ? ;
          dcterms:temporal @<DpvInterval> ?
       ) ;
       rdf:type [ <DpvTerm> ]
    )
}

